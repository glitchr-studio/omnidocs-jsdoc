		-
			message: '#^Method Omnidocs\\Jsdoc\\JsdocSource\:\:fileOf\(\) has parameter \$doclet with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: JsdocSource.php

		-
			message: '#^Method Omnidocs\\Jsdoc\\JsdocSource\:\:kindOf\(\) has parameter \$doclet with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: JsdocSource.php

		-
			message: '#^Method Omnidocs\\Jsdoc\\JsdocSource\:\:signature\(\) has parameter \$doclet with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
