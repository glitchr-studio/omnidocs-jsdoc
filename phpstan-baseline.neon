			count: 1
			path: JsdocSource.php

		-
			message: '#^Strict comparison using \=\=\= between ''package'' and ''class''\|''constant''\|''event''\|''function''\|''member''\|''namespace''\|''typedef'' will always evaluate to false\.$#'
