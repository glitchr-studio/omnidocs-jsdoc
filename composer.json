{
    "name": "omnidocs/jsdoc",
    "type": "library",
    "description": "Omnidocs JSDoc: a JavaScript library's API reference from the JSON JSDoc explains (jsdoc -X) - a page per global, its functions, methods and properties with their comments, parameters and source lines; a library of browser scripts (IIFE, UMD) named by the globals it sets.",
    "keywords": ["documentation", "api reference", "javascript", "jsdoc", "omnidocs"],
    "homepage": "https://github.com/glitchr-studio/omnidocs-jsdoc",
    "license": "MIT",
    "authors": [{"name": "Marco Meyer", "email": "marco.meyer@glitchr.io"}],
    "require": {
        "php": ">=8.2",
        "omniscient/omnidocs": "^1.0@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {"Omnidocs\\Jsdoc\\": ""},
        "exclude-from-classmap": ["/Tests/"]
    },
    "autoload-dev": {
        "psr-4": {"Omnidocs\\Jsdoc\\Tests\\": "Tests/"}
    },
    "extra": {
        "branch-alias": {"dev-1.x": "1.x-dev"}
    },
    "config": {"sort-packages": true}
}
